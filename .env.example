# Absolute path to Qdrant storage directory (required for MCP server)
LEXAU_SEARCH_STORAGE=/absolute/path/to/projects/lex-au-search/repo/qdrant_storage

# Path to lex-au corpus directory (optional convenience for scripts)
LEXAU_CORPUS_DIR=/absolute/path/to/projects/lex-au/repo/corpus

# Required for `python scripts/run_sharded_ingest.py --backend runpod`
RUNPOD_API_KEY=
# SSH private key whose public half is registered in the RunPod dashboard
# (Settings -> SSH Keys). RunPod injects the registered pubkey into the pod.
RUNPOD_SSH_KEY=~/.ssh/id_ed25519

# Fine-grained token: WRITE access to cchew/lex-au-search-embed-cache ONLY.
# huggingface.co/settings/tokens -> "Fine-grained". NOT your account-wide token.
HF_CACHE_WRITE_TOKEN=
